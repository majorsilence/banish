{
  "realm": "banish", "enabled": true, "sslRequired": "none",
  "roles": {"realm": [{"name":"banish-admin"},{"name":"banish-viewer"}]},
  "clients": [{
    "clientId": "banish", "secret": "banish-test-secret", "enabled": true,
    "publicClient": false, "standardFlowEnabled": true, "directAccessGrantsEnabled": true,
    "redirectUris": ["http://localhost:5080/*"], "webOrigins": ["+"],
    "protocolMappers": [{
      "name": "realm-roles-flat", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
      "config": {"claim.name":"roles","multivalued":"true","jsonType.label":"String",
                 "id.token.claim":"true","access.token.claim":"true","userinfo.token.claim":"true"}
    }]
  }],
  "users": [
    {"username":"alice","enabled":true,"email":"alice@example.test","emailVerified":true,"firstName":"Alice","lastName":"Admin",
     "credentials":[{"type":"password","value":"alice-pass","temporary":false}],"realmRoles":["banish-admin"]},
    {"username":"bob","enabled":true,"email":"bob@example.test","emailVerified":true,"firstName":"Bob","lastName":"Viewer",
     "credentials":[{"type":"password","value":"bob-pass","temporary":false}],"realmRoles":["banish-viewer"]},
    {"username":"carol","enabled":true,"email":"carol@example.test","emailVerified":true,"firstName":"Carol","lastName":"Nobody",
     "credentials":[{"type":"password","value":"carol-pass","temporary":false}],"realmRoles":[]}
  ]
}
