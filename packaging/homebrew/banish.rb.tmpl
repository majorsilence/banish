# Generated by packaging/generate-manifests.sh for @VERSION@. To publish: copy to Formula/banish.rb in a tap
# (for example the repository majorsilence/homebrew-tap) and users run:  brew install majorsilence/tap/banish
class Banish < Formula
  desc "Shared IP banning for failed logins: fail2ban/IPBan style agents with a central database"
  homepage "https://github.com/majorsilence/banish"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0", "BSD-3-Clause"]

  on_arm do
    url "https://github.com/majorsilence/banish/releases/download/v@VERSION@/banish-@VERSION@-osx-arm64.tar.gz"
    sha256 "@SHA_ARM64@"
  end
  on_intel do
    url "https://github.com/majorsilence/banish/releases/download/v@VERSION@/banish-@VERSION@-osx-x64.tar.gz"
    sha256 "@SHA_X64@"
  end

  def install
    bin.install "banish", "banish-agent", "banish-api"
    doc.install "README.md", "LICENSE", "CHANGELOG.md"
    doc.install Dir["docs/*"]
  end

  def caveats
    <<~EOS
      The agent edits the pf firewall, so it must run as root:
        sudo banish config init
        sudo banish install          # registers a launchd daemon
      For the central registry and dashboard:  sudo banish install --api
      Documentation: #{doc}/DEPLOYMENT.md
    EOS
  end

  test do
    assert_match "banish - manage banned IP addresses", shell_output("#{bin}/banish help")
  end
end
