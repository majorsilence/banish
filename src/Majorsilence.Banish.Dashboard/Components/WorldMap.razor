<figure class="chart">
    @((MarkupString)Svg())
    <figcaption class="muted">Each bubble sits at the centre of a country and is sized by its number of active bans.@(Unlocated > 0 ? $" {Unlocated.ToString("N0", CultureInfo.InvariantCulture)} could not be placed." : "")</figcaption>
</figure>

@code {
    private const double W = 560, H = 280;

    [Parameter, EditorRequired] public IReadOnlyList<GeoBubble> Bubbles { get; set; } = [];
    [Parameter] public int Unlocated { get; set; }

    private static double X(double lon) => (lon + 180) / 360 * W;

    private static double Y(double lat) => (90 - lat) / 180 * H;

    // Built as a string (a <text> tag in Razor markup is read as a Razor directive).
    private string Svg()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(CultureInfo.InvariantCulture, $"<svg viewBox=\"0 0 {W} {H}\" role=\"img\" aria-label=\"Map of active bans by country\" class=\"geomap\">");
        for (int lon = -150; lon <= 150; lon += 30)
        {
            sb.Append(CultureInfo.InvariantCulture, $"<line x1=\"{X(lon):0.#}\" y1=\"0\" x2=\"{X(lon):0.#}\" y2=\"{H}\" stroke=\"var(--grid)\" stroke-width=\"1\"/>");
        }

        for (int lat = -60; lat <= 60; lat += 30)
        {
            string stroke = lat == 0 ? "var(--axis)" : "var(--grid)";
            sb.Append(CultureInfo.InvariantCulture, $"<line x1=\"0\" y1=\"{Y(lat):0.#}\" x2=\"{W}\" y2=\"{Y(lat):0.#}\" stroke=\"{stroke}\" stroke-width=\"1\"/>");
        }

        sb.Append(CultureInfo.InvariantCulture, $"<rect x=\"0.5\" y=\"0.5\" width=\"{W - 1}\" height=\"{H - 1}\" fill=\"none\" stroke=\"var(--axis)\"/>");
        int max = Bubbles.Count == 0 ? 1 : Bubbles.Max(b => b.Count);
        // Largest first so small bubbles are never hidden under big ones.
        foreach (var b in Bubbles.OrderByDescending(b => b.Count))
        {
            double r = 4 + 16 * Math.Sqrt((double)b.Count / max);
            string tip = System.Net.WebUtility.HtmlEncode($"{b.Name}: {b.Count:N0} active ban{(b.Count == 1 ? "" : "s")}");
            sb.Append(CultureInfo.InvariantCulture,
                $"<circle cx=\"{X(b.Lon):0.#}\" cy=\"{Y(b.Lat):0.#}\" r=\"{r:0.#}\" fill=\"var(--series-1)\" fill-opacity=\"0.65\" stroke=\"var(--surface)\" stroke-width=\"2\"><title>{tip}</title></circle>");
        }

        foreach (var b in Bubbles.Take(5))
        {
            double r = 4 + 16 * Math.Sqrt((double)b.Count / max);
            sb.Append(CultureInfo.InvariantCulture,
                $"<text x=\"{X(b.Lon):0.#}\" y=\"{Y(b.Lat) - r - 3:0.#}\" text-anchor=\"middle\" font-size=\"10\" fill=\"var(--ink-2)\">{System.Net.WebUtility.HtmlEncode(b.Code)}</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }
}
